# Optional: connect your own Supabase project. Without these values the app runs in demo mode.
# Use the publishable key only – never the secret/service_role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_YOUR_KEY
# VITE_DEMO=true   # force demo mode even with credentials
